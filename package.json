{
  "name": "parchapp-backend",
  "private": true,
  "description": "Firebase backend shared by the ParchApp Android (Java) and Flutter apps",
  "scripts": {
    "test": "npm run test:functions && npm run test:rules",
    "test:functions": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-parchapp \"node --test --test-concurrency=1 \\\"tests/**/*.test.js\\\"\"",
    "emulators": "firebase emulators:start --project demo-parchapp",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.0"
  }
}
