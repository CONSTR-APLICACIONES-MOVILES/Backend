rules_version = '2';

// Shared by the Android (Java) and Flutter clients. The data shapes are described in docs/data-model.md.
// The backend (Cloud Functions and scripts/seed.js) uses the Admin SDK, which skips these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Draft ownership, revisions and publication receipts are enforced by
    // authenticated callables. Clients cannot bypass that contract directly.
    match /privateDraftOwners/{owner}/{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupData) {
      return signedIn() && request.auth.uid in groupData.memberIds;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    // Elements added or removed between two arrays.
    function changed(before, after) {
      return before.toSet().difference(after.toSet())
          .union(after.toSet().difference(before.toSet()));
    }

    function validDescription(data) {
      return !('description' in data)
          || (data.description is string && data.description.size() <= 5000);
    }

    function validPlanningContext(data) {
      return !('planningContext' in data)
          || (data.planningContext is map
              && (!('groupSizeAtCreation' in data.planningContext)
                  || data.planningContext.groupSizeAtCreation is int)
              && (!('comparisonUsed' in data.planningContext)
                  || data.planningContext.comparisonUsed is bool)
              && (!('comparisonId' in data.planningContext)
                  || data.planningContext.comparisonId is string
                  || data.planningContext.comparisonId == null)
              && (!('locationAreaId' in data.planningContext)
                  || data.planningContext.locationAreaId is string)
              && (!('timeBucket' in data.planningContext)
                  || data.planningContext.timeBucket is string));
    }

    match /groups/{groupId} {
      allow read: if isMember(resource.data);

      // Groups are created by the backend only (seed script and new-user trigger).
      allow create, delete: if false;

      // Members may RSVP for themselves and manage pending invitations. Nothing else changes from a client.
      allow update: if isMember(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['goingIds', 'maybeIds', 'pendingInvites'])
          && changed(resource.data.goingIds, request.resource.data.goingIds).hasOnly([request.auth.uid])
          && changed(resource.data.maybeIds, request.resource.data.maybeIds).hasOnly([request.auth.uid])
          && request.resource.data.pendingInvites.size() <= 50;
    }

    match /activities/{activityId} {
      // Queries must filter by groupId so this rule can be checked.
      allow read: if signedIn() && isMember(groupData(resource.data.groupId));

      allow create: if signedIn()
          && isMember(groupData(request.resource.data.groupId))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status in ['PROPOSED', 'CONFIRMED']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
           && validDescription(request.resource.data)
           && validPlanningContext(request.resource.data)
           && request.resource.data.keys().hasOnly(
                ['groupId', 'title', 'description', 'category', 'date', 'time', 'location', 'status', 'createdBy', 'createdAt', 'planningContext']);

      // Only the organiser may confirm or edit their activity; groupId and createdBy never change.
      allow update: if signedIn()
          && resource.data.createdBy == request.auth.uid
          && resource.data.get('cancelled', false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'description', 'category', 'date', 'time', 'location', 'status'])
          && validDescription(request.resource.data)
          // Canonical schedules must stay consistent with their display fields.
          && (!('startTime' in resource.data)
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['date', 'time']))
          && request.resource.data.status in ['PROPOSED', 'CONFIRMED'];

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Only the authenticated callable functions may record impressions and decisions.
    match /slotRecommendations/{recommendationId} {
      allow read, write: if false;
    }

    // These records are backend-owned projections. Mobile clients use callable APIs.
    match /activities/{activityId}/lifecycle/{eventId} {
      allow read, write: if false;
    }

    match /inboxes/{userId}/items/{activityId} {
      allow read, write: if false;
    }

    match /inboxes/{userId}/items/{activityId}/reminders/{reminderId} {
      allow read, write: if false;
    }

    // the app writes one document per event for the team dashboard, it can not read, edit or delete them
    // only the name, the params, the sha256 hash of the user and the server time are accepted
    match /analyticsEvents/{eventId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'params', 'user_hash', 'created_at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.params is map
          && request.resource.data.params.size() <= 25
          && (!('user_hash' in request.resource.data)
              || request.resource.data.user_hash == null
              || (request.resource.data.user_hash is string && request.resource.data.user_hash.size() == 32))
          && request.resource.data.created_at == request.time;
    }

    // chat: a message is written by its sender only, with the server time, and never edited or deleted
    // kind "slot" is a common free slot shared from the chat, its text is the slot as the sender saw it
    function validMessage(data) {
      return data.keys().hasOnly(['senderId', 'senderName', 'senderInitials', 'text', 'kind', 'createdAt'])
          && data.senderId == request.auth.uid
          && data.senderName is string && data.senderName.size() <= 80
          && data.senderInitials is string && data.senderInitials.size() <= 4
          && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
          && data.kind in ['text', 'slot']
          && data.createdAt == request.time;
    }

    // House Chat: the messages of a group, only its members read and write them
    match /groups/{groupId}/messages/{messageId} {
      allow read: if isMember(groupData(groupId));
      allow create: if isMember(groupData(groupId)) && validMessage(request.resource.data);
      allow update, delete: if false;
    }

    // chat between two people: the id is the two uids sorted and joined with "_", only those two read and write
    match /directChats/{pairId}/messages/{messageId} {
      allow read: if signedIn() && pairId.split('_').size() == 2 && request.auth.uid in pairId.split('_');
      allow create: if signedIn() && pairId.split('_').size() == 2 && request.auth.uid in pairId.split('_')
          && validMessage(request.resource.data);
      allow update, delete: if false;
    }

    // BQ2 observations are validated and deduplicated by recordCreationAttempt.
    match /creationAttempts/{attemptId} {
      allow read, write: if false;
    }
    // Public-minimal DTOs and relationship commands are served through callables.
    match /usernames/{name} { allow read, write: if false; }
    match /publicPeople/{uid} { allow read, write: if false; }
    match /friendships/{pairId} { allow read, write: if false; }
    match /reminderMeasurements/{activityId} { allow read, write: if false; }
    match /reminderDeliveries/{deliveryId} { allow read, write: if false; }
    // Andes Events added to Schedule: only the mobile callables read or write them (busy minutes reach friends)
    match /andesSchedule/{userId}/{document=**} { allow read, write: if false; }

    // Reference data written by the seed script: where activities can happen, with coordinates.
    match /campusAreas/{areaId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Help questions of the Java app (Help screen). Read only: they are loaded with scripts/seed-help-faq.js.
    match /helpFaq/{questionId} { allow read: if signedIn(); allow write: if false; }

    // Aggregates belong to the organization dashboard. Apps receive operational
    // recommendations through authenticated callables, not raw dashboard data.
    match /insights/{insightId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // =========================================================
    // FLUTTER SCHEDULE AND ANDES EVENTS (direct reads from the Flutter client)
    // Java uses callables for this data; these rules only add access for Flutter.
    // =========================================================

    function isOwner(userId) {
      return signedIn()
          && request.auth.uid == userId;
    }

    // Checks whether the currently authenticated user has an
    // accepted friendship with another user.
    //
    // Friendship documents are stored under:
    //
    // users/{currentUserId}/friends/{friendUserId}
    //
    function isAcceptedFriend(otherUserId) {
      return signedIn()
          && request.auth.uid != otherUserId
          && exists(
            /databases/$(database)/documents/users/$(request.auth.uid)/friends/$(otherUserId)
          )
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)/friends/$(otherUserId)
          ).data.status == 'accepted';
    }

    function validDayKey(data) {
      return data.dayKey is string
          && data.dayKey.size() == 10;
    }

    // =========================================================
    // USERS
    // =========================================================
    //
    // Public/basic profile information used by Schedule.
    //
    // Structure:
    //
    // users/{userId}
    //
    // Example:
    //
    // {
    //   name: "Daniel",
    //   fullName: "Daniel Martinez",
    //   initials: "DM"
    // }
    //
    // Location is intentionally NOT stored here.
    //
    // =========================================================

    match /users/{userId} {

      // A user can read their own profile.
      //
      // Accepted friends can also read the basic profile.
      allow read: if isOwner(userId)
          || isAcceptedFriend(userId);

      // Users may create/update only their own profile.
      allow create, update: if isOwner(userId)

          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80

          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() > 0
          && request.resource.data.fullName.size() <= 160

          && request.resource.data.initials is string
          && request.resource.data.initials.size() > 0
          && request.resource.data.initials.size() <= 5

          && request.resource.data.keys().hasOnly([
            'name',
            'fullName',
            'initials'
          ]);

      allow delete: if isOwner(userId);


      // =======================================================
      // FRIEND RELATIONSHIPS
      // =======================================================
      //
      // users/{userId}/friends/{friendId}
      //
      // Example:
      //
      // users/gabriel/friends/daniel
      //
      // {
      //   friendId: "daniel",
      //   status: "accepted",
      //   createdAt: timestamp
      // }
      //
      // For now friendship relationships are backend-managed.
      // The seed script creates them.
      //
      // =======================================================

      match /friends/{friendId} {

        // A user can read their own friend list.
        allow read: if isOwner(userId);

        // For the current prototype, friendships are created
        // only by trusted backend code / seed scripts.
        allow create, update, delete: if false;
      }
    }


    // =========================================================
    // USER LOCATIONS
    // =========================================================
    //
    // Location is separated from the profile because it is
    // contextual/private information.
    //
    // Structure:
    //
    // locations/{userId}
    //
    // {
    //   location: GeoPoint,
    //   updatedAt: timestamp
    // }
    //
    // Current user:
    //     real GPS position
    //
    // Demo friends:
    //     dummy positions generated by the seed
    //
    // =========================================================

    match /locations/{userId} {

      // Owner can read their location.
      //
      // Accepted friends can read the shared location so that
      // Schedule can calculate nearby friends.
      allow read: if isOwner(userId)
          || isAcceptedFriend(userId);

      // A user may update only their own GPS location.
      allow create, update: if isOwner(userId)

          && request.resource.data.location is latlng

          && request.resource.data.updatedAt is timestamp

          && request.resource.data.keys().hasOnly([
            'location',
            'updatedAt'
          ]);

      allow delete: if isOwner(userId);
    }

    // =========================================================
    // PRIVATE USER SCHEDULE
    // =========================================================
    //
    // Complete Google Calendar information.
    //
    // PRIVATE:
    // only the owner may read it.
    //
    // Structure:
    //
    // schedules/{userId}
    // schedules/{userId}/slots/{slotId}
    //
    // Example private slot:
    //
    // {
    //   title: "...",
    //   description: "...",
    //   location: "...",
    //   start: timestamp,
    //   end: timestamp
    // }
    //
    // Friends NEVER read this collection.
    //
    // =========================================================

    match /schedules/{userId} {

      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)

          && request.resource.data.ownerId == userId

          && request.resource.data.source ==
              'google_calendar'

          && request.resource.data.importedCount is int
          && request.resource.data.importedCount >= 0

          && request.resource.data.lastImportedAt is timestamp

          && request.resource.data.keys().hasOnly([
            'ownerId',
            'source',
            'lastImportedAt',
            'importedCount'
          ]);

      allow delete: if isOwner(userId);


      // -------------------------------------------------------
      // PRIVATE CALENDAR SLOTS
      // -------------------------------------------------------

      match /slots/{slotId} {

        // Only the owner can see complete event information.
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)

            && request.resource.data.externalId is string
            && request.resource.data.externalId.size() > 0

            && request.resource.data.title is string

            && (
              !(
                'description'
                in request.resource.data
              )
              || request.resource.data.description is string
            )

            && (
              !(
                'location'
                in request.resource.data
              )
              || request.resource.data.location is string
            )

            && request.resource.data.start is timestamp
            && request.resource.data.end is timestamp
            && request.resource.data.end >
                request.resource.data.start

            && validDayKey(
              request.resource.data
            )

            && request.resource.data.source in ['google_calendar', 'andes_events']

            && request.resource.data.importedAt is timestamp

            && request.resource.data.keys().hasOnly([
              'externalId',
              'title',
              'description',
              'location',
              'start',
              'end',
              'dayKey',
              'source',
              'importedAt'
            ]);

        allow delete: if isOwner(userId);
      }
    }


    // =========================================================
    // SHARED AVAILABILITY
    // =========================================================
    //
    // Privacy-safe projection of a user's schedule.
    //
    // Unlike schedules/{uid}/slots, these documents NEVER
    // contain:
    //
    // - title
    // - description
    // - location
    // - Google event id
    //
    // Friends only learn:
    //
    // "This user is busy from X to Y."
    //
    // Structure:
    //
    // availability/{userId}
    // availability/{userId}/slots/{slotId}
    //
    // =========================================================

    match /availability/{userId} {

      // Owner and accepted friends can read availability.
      allow read: if isOwner(userId)
          || isAcceptedFriend(userId);

      // Metadata can only be generated/updated by the owner.
      allow create, update: if isOwner(userId)

          && request.resource.data.ownerId == userId

          && request.resource.data.slotCount is int
          && request.resource.data.slotCount >= 0

          && request.resource.data.updatedAt is timestamp

          && request.resource.data.keys().hasOnly([
            'ownerId',
            'slotCount',
            'updatedAt'
          ]);

      allow delete: if isOwner(userId);


      // -------------------------------------------------------
      // SHARED BUSY SLOTS
      // -------------------------------------------------------

      match /slots/{slotId} {

        // Friends may see only the safe projection.
        allow read: if isOwner(userId)
            || isAcceptedFriend(userId);

        // The owner creates their own availability projection.
        allow create, update: if isOwner(userId)

            && request.resource.data.start is timestamp

            && request.resource.data.end is timestamp

            && request.resource.data.end >
                request.resource.data.start

            && validDayKey(
              request.resource.data
            )

            // No other field is allowed.
            //
            // This prevents accidentally storing:
            // title, description or location.
            && request.resource.data.keys().hasOnly([
              'start',
              'end',
              'dayKey'
            ]);

        allow delete: if isOwner(userId);
      }
    }


    match /andesEvents/{eventId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;
    }
  }
}
